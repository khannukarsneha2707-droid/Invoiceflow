rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Verified: Allows users to manage files in their own subfolder.
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
